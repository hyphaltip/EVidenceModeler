#!/bin/bash
#
# evm-mariadb -- manage a rootless, self-contained MariaDB instance suitable
# for embedding a MySQL-compatible database alongside EVidenceModeler /
# funannotate / PASA inside a Singularity/Apptainer (or Docker) container.
#
# The container filesystem is read-only under Singularity, so ALL mutable
# state (data directory, socket, logs, pidfile) lives under a user-writable
# host path selected with EVM_DB_HOME (default: $PWD/evm_mariadb).
#
# Usage:
#   evm-mariadb init                 # one-time: create the data directory
#   evm-mariadb start                # start the server (backgrounded)
#   evm-mariadb status               # is it running?
#   evm-mariadb shell [db]           # open a mariadb client on the socket
#   evm-mariadb create-db NAME [USER PASS]   # create db (+ optional user)
#   evm-mariadb pasa-conf NAME [USER PASS]   # print a PASA/funannotate conf
#   evm-mariadb stop                 # shut the server down cleanly
#   evm-mariadb destroy              # stop + delete the data directory
#
# Configuration (environment variables):
#   EVM_DB_HOME   base dir for all state      (default: $PWD/evm_mariadb)
#   EVM_DB_PORT   TCP port on 127.0.0.1       (default: 3306)
#   EVM_DB_BIND   bind address                (default: 127.0.0.1)
#
set -euo pipefail

EVM_DB_HOME="${EVM_DB_HOME:-$PWD/evm_mariadb}"
EVM_DB_PORT="${EVM_DB_PORT:-3306}"
EVM_DB_BIND="${EVM_DB_BIND:-127.0.0.1}"

DATADIR="${EVM_DB_HOME}/data"
SOCKET="${EVM_DB_HOME}/mysql.sock"
PIDFILE="${EVM_DB_HOME}/mariadb.pid"
ERRLOG="${EVM_DB_HOME}/mariadb.err"
MYCNF="${EVM_DB_HOME}/my.cnf"

# --- Resolve tool names (MariaDB 10.5+ renamed the mysql* binaries) --------
_bin() { command -v "$1" 2>/dev/null || command -v "$2" 2>/dev/null || true; }
MARIADBD="$(_bin mariadbd mysqld)"
INSTALL_DB="$(_bin mariadb-install-db mysql_install_db)"
CLIENT="$(_bin mariadb mysql)"
ADMIN="$(_bin mariadb-admin mysqladmin)"

_die()  { echo "evm-mariadb: $*" >&2; exit 1; }
_info() { echo "[evm-mariadb] $*" >&2; }

_write_mycnf() {
  cat > "${MYCNF}" <<EOF
# Generated by evm-mariadb -- do not edit by hand.
[mysqld]
datadir         = ${DATADIR}
socket          = ${SOCKET}
pid-file        = ${PIDFILE}
log-error       = ${ERRLOG}
port            = ${EVM_DB_PORT}
bind-address    = ${EVM_DB_BIND}
skip-networking = 0
# Keep everything under EVM_DB_HOME; no system-wide paths.
tmpdir          = ${EVM_DB_HOME}/tmp
lower_case_table_names = 0

[client]
socket = ${SOCKET}
port   = ${EVM_DB_PORT}
host   = ${EVM_DB_BIND}
EOF
}

_running() {
  [[ -f "${PIDFILE}" ]] && kill -0 "$(cat "${PIDFILE}")" 2>/dev/null
}

_wait_ready() {
  local tries=60
  while (( tries-- > 0 )); do
    if "${ADMIN}" --defaults-file="${MYCNF}" --socket="${SOCKET}" ping >/dev/null 2>&1; then
      return 0
    fi
    sleep 0.5
  done
  return 1
}

cmd_init() {
  [[ -n "${INSTALL_DB}" ]] || _die "mariadb-install-db not found in container"
  if [[ -d "${DATADIR}/mysql" ]]; then
    _info "data directory already initialized at ${DATADIR}"
    return 0
  fi
  mkdir -p "${DATADIR}" "${EVM_DB_HOME}/tmp"
  _write_mycnf
  _info "initializing data directory at ${DATADIR}"
  "${INSTALL_DB}" \
      --datadir="${DATADIR}" \
      --auth-root-authentication-method=normal \
      --skip-test-db \
      --user="$(id -un)" >/dev/null
  _info "initialized. Start it with:  evm-mariadb start"
}

cmd_start() {
  [[ -n "${MARIADBD}" ]] || _die "mariadbd not found in container"
  [[ -d "${DATADIR}/mysql" ]] || _die "not initialized; run 'evm-mariadb init' first"
  if _running; then _info "already running (pid $(cat "${PIDFILE}"))"; return 0; fi
  _write_mycnf
  _info "starting MariaDB (socket=${SOCKET}, tcp=${EVM_DB_BIND}:${EVM_DB_PORT})"
  # nohup + background so it survives the launching shell inside the container.
  nohup "${MARIADBD}" --defaults-file="${MYCNF}" --user="$(id -un)" \
        >>"${ERRLOG}" 2>&1 &
  echo $! > "${PIDFILE}"
  if _wait_ready; then
    _info "ready. Connect with:  evm-mariadb shell"
  else
    _die "server did not become ready; see ${ERRLOG}"
  fi
}

cmd_stop() {
  if ! _running; then _info "not running"; return 0; fi
  _info "shutting down"
  "${ADMIN}" --defaults-file="${MYCNF}" --socket="${SOCKET}" -u root shutdown 2>/dev/null \
    || kill "$(cat "${PIDFILE}")" 2>/dev/null || true
  rm -f "${PIDFILE}"
}

cmd_status() {
  if _running; then
    echo "running (pid $(cat "${PIDFILE}"))"
    echo "  socket : ${SOCKET}"
    echo "  tcp    : ${EVM_DB_BIND}:${EVM_DB_PORT}"
    echo "  datadir: ${DATADIR}"
  else
    echo "stopped"
  fi
}

cmd_shell() {
  _running || _die "server not running; run 'evm-mariadb start'"
  "${CLIENT}" --defaults-file="${MYCNF}" --socket="${SOCKET}" -u root "${1:-}"
}

cmd_create_db() {
  local db="${1:?usage: evm-mariadb create-db NAME [USER PASS]}"
  local user="${2:-}" pass="${3:-}"
  _running || _die "server not running; run 'evm-mariadb start'"
  local sql="CREATE DATABASE IF NOT EXISTS \`${db}\`;"
  if [[ -n "${user}" ]]; then
    sql+=" CREATE USER IF NOT EXISTS '${user}'@'%' IDENTIFIED BY '${pass}';"
    sql+=" CREATE USER IF NOT EXISTS '${user}'@'localhost' IDENTIFIED BY '${pass}';"
    sql+=" GRANT ALL PRIVILEGES ON \`${db}\`.* TO '${user}'@'%';"
    sql+=" GRANT ALL PRIVILEGES ON \`${db}\`.* TO '${user}'@'localhost';"
    sql+=" FLUSH PRIVILEGES;"
  fi
  echo "${sql}" | "${CLIENT}" --defaults-file="${MYCNF}" --socket="${SOCKET}" -u root
  _info "database '${db}' ready${user:+ (user '${user}')}"
}

cmd_pasa_conf() {
  local db="${1:?usage: evm-mariadb pasa-conf NAME [USER PASS]}"
  local user="${2:-pasa}" pass="${3:-pasa}"
  cmd_create_db "${db}" "${user}" "${pass}" >/dev/null
  cat <<EOF
# ---- PASA / funannotate MySQL connection ---------------------------------
# Server managed by evm-mariadb; TCP on 127.0.0.1 (PASA connects via DBI:mysql).
MYSQLDB=${db}
MYSQL_RW_USER=${user}
MYSQL_RW_PASSWORD=${pass}
MYSQL_RO_USER=${user}
MYSQL_RO_PASSWORD=${pass}
MYSQLSERVER=${EVM_DB_BIND}
# In PASA's conf.txt / alignAssembly config use host=${EVM_DB_BIND}:${EVM_DB_PORT}
# --------------------------------------------------------------------------
EOF
}

cmd_destroy() {
  cmd_stop || true
  _info "removing ${EVM_DB_HOME}"
  rm -rf "${EVM_DB_HOME}"
}

case "${1:-}" in
  init)       shift; cmd_init "$@" ;;
  start)      shift; cmd_start "$@" ;;
  stop)       shift; cmd_stop "$@" ;;
  status)     shift; cmd_status "$@" ;;
  shell)      shift; cmd_shell "$@" ;;
  create-db)  shift; cmd_create_db "$@" ;;
  pasa-conf)  shift; cmd_pasa_conf "$@" ;;
  destroy)    shift; cmd_destroy "$@" ;;
  ""|-h|--help|help)
    # Print the leading comment block (skip the shebang; stop at first
    # non-comment line), stripping the leading "# ".
    awk 'NR==1{next} /^#/{sub(/^# ?/,""); print; next} {exit}' "$0"
    ;;
  *) _die "unknown command '$1' (try: evm-mariadb --help)" ;;
esac
